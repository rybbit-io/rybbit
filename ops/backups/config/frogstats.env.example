# Copy to /etc/rybbit-backup.env on the FrogStats host and chmod 600.

BACKUP_HOST=frogstats

# PostgreSQL: upload through the Backblaze B2 rclone remote.
POSTGRES_CONTAINER=postgres
POSTGRES_DATABASE=analytics
POSTGRES_STAGING_ROOT=/var/backups/rybbit/postgres
POSTGRES_RCLONE_REMOTES=backblaze:rybbit-backups/frogstats/postgres

# ClickHouse: direct native backup avoids staging ~58 GiB on this host.
CLICKHOUSE_CONTAINER=clickhouse
CLICKHOUSE_DATABASE=analytics
CLICKHOUSE_BACKUP_MODE=s3
# Native backups can be quiet for longer than clickhouse-client's 300s default.
CLICKHOUSE_BACKUP_RECEIVE_TIMEOUT=21600
CLICKHOUSE_BACKUP_USER=backup
# Must match the SHA-256 hash installed in clickhouse-backup-user.xml.
CLICKHOUSE_BACKUP_PASSWORD=replace-me
CLICKHOUSE_S3_NAMED_COLLECTION=b2_backups

# Optional monitoring endpoints, such as Healthchecks.io ping URLs.
# POSTGRES_SUCCESS_URL=
# POSTGRES_FAILURE_URL=
# CLICKHOUSE_SUCCESS_URL=
# CLICKHOUSE_FAILURE_URL=
