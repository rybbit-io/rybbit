# Copy to /etc/rybbit-backup.env on the standalone ClickHouse host and chmod 600.

BACKUP_HOST=clickhouse

CLICKHOUSE_CONTAINER=clickhouse
CLICKHOUSE_DATABASE=analytics
CLICKHOUSE_BACKUP_MODE=local
CLICKHOUSE_BACKUP_RECEIVE_TIMEOUT=21600
CLICKHOUSE_BACKUP_DISK=backups
CLICKHOUSE_LOCAL_BACKUP_ROOT=/var/backups/rybbit/clickhouse
CLICKHOUSE_KEEP_LOCAL_BACKUP=false

# Upload the completed native snapshot to Backblaze. Let B2 lifecycle rules
# handle retention instead of granting this host permission to delete backups.
CLICKHOUSE_RCLONE_REMOTES=backblaze:rybbit-backups/clickhouse/analytics
# Native disk backups contain many small files, so use more parallel transfers
# than the conservative defaults used for PostgreSQL archives.
RCLONE_TRANSFERS=16
RCLONE_CHECKERS=32

# CLICKHOUSE_SUCCESS_URL=
# CLICKHOUSE_FAILURE_URL=
