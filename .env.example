# Domain and URL Configuration
# Replace with the domain or subdomain that points to this server
DOMAIN_NAME=your.domain.com
BASE_URL="https://${DOMAIN_NAME}"

# Authentication and Security
# Required. Generate a random secret with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-with-output-of-openssl-rand-hex-32
DISABLE_SIGNUP=false

# Webserver Configuration
# Set to false to disable the built-in Caddy webserver
USE_WEBSERVER=true
# Host port mappings - these control how services are exposed
# Format: "host_ip:host_port:container_port" or "host_port:container_port"
# Without a host_ip the port is published on all interfaces.
HOST_BACKEND_PORT=127.0.0.1:3001:3001
HOST_CLIENT_PORT=127.0.0.1:3002:3002

CLICKHOUSE_DB=analytics
# The backend always connects to ClickHouse as the "default" user, so don't set CLICKHOUSE_USER.
CLICKHOUSE_PASSWORD=frog

POSTGRES_DB=analytics
POSTGRES_USER=frog
POSTGRES_PASSWORD=frog

REDIS_PASSWORD=changeme

# External Service Tokens (optional)
MAPBOX_TOKEN=
