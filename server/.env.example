NODE_ENV=development

# ClickHouse configuration
CLICKHOUSE_HOST=http://localhost:8123
CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# PostgreSQL configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=analytics
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication
BETTER_AUTH_SECRET=your-secret-key-here

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AppSumo (optional - cloud only)
APPSUMO_CLIENT_ID=
APPSUMO_CLIENT_SECRET=

# R2 Storage (optional)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Managed Proxy via Cloudflare for SaaS (optional)
# Set all three to enable customers to serve tracking first-party from their own
# subdomain. Token needs Zone > SSL and Certificates: Edit + Custom Hostnames on the zone.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# The CNAME target customers point their subdomain at (your SaaS fallback-origin host),
# e.g. customers.rybbit.io
CLOUDFLARE_SAAS_CNAME_TARGET=
