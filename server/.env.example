NODE_ENV=development

# ClickHouse configuration
CLICKHOUSE_HOST=http://localhost:8123
CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# PostgreSQL configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=analytics
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication
BETTER_AUTH_SECRET=your-secret-key-here

# Optional comma-separated browser origins allowed to call /api/mcp.
# Server-side MCP clients normally omit Origin and do not need this setting.
MCP_ALLOWED_ORIGINS=

# Set to true to expose session-level MCP tools and raw SQL (get_sessions, get_events, run_query).
# Default off: the MCP surface then only serves aggregate analytics.
MCP_ENABLE_RAW_DATA_TOOLS=false

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AppSumo (optional - cloud only)
APPSUMO_CLIENT_ID=
APPSUMO_CLIENT_SECRET=

# R2 Storage (optional)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
