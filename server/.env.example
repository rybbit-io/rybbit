NODE_ENV=development

# ClickHouse configuration
CLICKHOUSE_HOST=http://localhost:8123
CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# PostgreSQL configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=analytics
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Shared dashboard cache lifetime, in seconds (0 disables; maximum 30).
# Live counts, sessions, user details and custom SQL are not cached.
DASHBOARD_CACHE_TTL_SECONDS=30

# Optional diagnostics for accepted requests with elevated weak bot signals.
# Comma-separated numeric Site IDs; blank disables. See src/services/tracker/botBlocking/README.md.
BOT_DIAGNOSTIC_SITE_IDS=

# Authentication
BETTER_AUTH_SECRET=your-secret-key-here

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AppSumo (optional - cloud only)
APPSUMO_CLIENT_ID=
APPSUMO_CLIENT_SECRET=

# R2 Storage (optional)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
